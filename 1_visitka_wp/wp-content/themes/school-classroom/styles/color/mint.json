{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "title": "Mint",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "color": "#000000", "name": "Foreground", "slug": "foreground" },
        { "color": "#4caf50", "name": "Primary", "slug": "primary" },
        { "color": "#81c784", "name": "Secondary", "slug": "secondary" },
        { "color": "#a5d6a7", "name": "Accent", "slug": "accent" },
        { "color": "#ffffff", "name": "Background", "slug": "background" },
        { "color": "#f2f2f2", "name": "Border", "slug": "border" }
      ],
      "gradients": [
        {
          "gradient": "linear-gradient(135deg, #a8e6cf 0%, #4caf50 100%)",
